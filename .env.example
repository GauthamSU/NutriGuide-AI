# Choose "local" for llama.cpp or "gemini" for the Google Gemini API.
INFERENCE_BACKEND=local

# Local llama.cpp server and model settings.
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_DIR=D:/llama-cpp
LLAMA_MODEL_PATH=D:/models/gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_MMPROJ_PATH=D:/models/mmproj-F16.gguf
LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_TIMEOUT_SECONDS=120

# Gemini settings. Set GEMINI_API_KEY to a private key if using Gemini.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=60

# Completion and local debugging output settings.
LLM_MAX_OUTPUT_TOKENS=1800
LLM_RESPONSE_DEBUG_FILE=llm_response_debug.json
API_RESPONSE_DEBUG_FILE=api_response_debug.json

# Browser origins allowed to call the separately hosted API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Chat history is isolated from the nutrient database. Leave SQLite for development.
CHAT_HISTORY_DB_ENGINE=django.db.backends.sqlite3
CHAT_HISTORY_DB_NAME=chat_history.sqlite3
CHAT_HISTORY_MEDIA_ROOT=media

# For production, select PostgreSQL and provide its connection settings.
# CHAT_HISTORY_DB_ENGINE=django.db.backends.postgresql
# CHAT_HISTORY_DB_NAME=nutriguide_chat
# CHAT_HISTORY_DB_USER=nutriguide
# CHAT_HISTORY_DB_PASSWORD=replace-with-a-secret
# CHAT_HISTORY_DB_HOST=postgres
# CHAT_HISTORY_DB_PORT=5432